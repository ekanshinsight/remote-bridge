# Copy this file to .env and fill in your own values.
# .env is already listed in .gitignore - never commit it.

# Which provider to use: openai | anthropic | meta | opencode-go
PROVIDER=opencode-go

# The endpoint root, no trailing slash.
#   OpenAI-style     https://api.example.com/v1
#   Anthropic-style  https://api.anthropic.com
#   Meta Model API   https://api.meta.ai
#   OpenCode Go      https://opencode.ai/zen/go
BASE_URL=

# The model name the provider expects.
MODEL=

# Your key. Leave blank here and put the real value only in .env.
API_KEY=
